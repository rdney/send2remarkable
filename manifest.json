{
  "manifest_version": 2,
  "name": "Send to reMarkable",
  "version": "0.5.1",
  "description": "Right-click a Zotero item and send its PDF to your reMarkable tablet via rmapi.",
  "author": "Rodney",
  "applications": {
    "zotero": {
      "id": "zotero-remarkable@rodney.local",
      "strict_min_version": "6.999",
      "strict_max_version": "10.0.*",
      "update_url": "https://raw.githubusercontent.com/rdney/send2remarkable/main/updates.json"
    }
  },
  "homepage_url": "https://github.com/rdney/send2remarkable"
}
